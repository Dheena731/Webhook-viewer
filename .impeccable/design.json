  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The principal action in the viewer.",
      "html": "<button class=\"ds-primary\">Send demo</button>",
      "css": ".ds-primary { background: var(--primary, #b54010); color: #fff; border: 0; border-radius: 6px; padding: 8px 14px; font: 600 13px ui-sans-serif, system-ui, sans-serif; transition: background .15s; } .ds-primary:hover { background: var(--primary-hover, #96340d); } .ds-primary:focus-visible { outline: 2px solid var(--primary, #b54010); outline-offset: 3px; }"
    },
    {
      "name": "Search field",
      "kind": "input",
      "description": "A compact bordered search field.",
      "html": "<input class=\"ds-search\" placeholder=\"Search events\" aria-label=\"Search events\">",
      "css": ".ds-search { height: 38px; padding: 0 12px; background: var(--bg-base, #f8f8f8); color: var(--text-primary, #262626); border: 1px solid var(--border, #dedede); border-radius: 5px; font: 13px ui-sans-serif, system-ui, sans-serif; } .ds-search:focus-visible { outline: 2px solid var(--primary, #b54010); outline-offset: 2px; }"
    },
    {
      "name": "Selected event",
      "kind": "custom",
      "refersTo": "event-selected",
      "description": "A selected row in the request ledger.",
      "html": "<div class=\"ds-event\"><strong>POST</strong> <code>/hooks/example</code></div>",
      "css": ".ds-event { padding: 14px 16px; background: var(--bg-selected, #fff3ec); color: var(--text-primary, #262626); border-bottom: 1px solid var(--border, #dedede); font: 13px ui-sans-serif, system-ui, sans-serif; } .ds-event code { font-family: ui-monospace, Consolas, monospace; }"
    },
    {
      "name": "Active endpoint",
      "kind": "nav",
      "description": "The selected endpoint in the sidebar.",
      "html": "<nav><a class=\"ds-endpoint\" href=\"#endpoint\">example</a></nav>",
      "css": ".ds-endpoint { display: block; padding: 8px 14px; border-radius: 4px; background: var(--bg-selected, #fff3ec); color: var(--primary, #b54010); font: 13px ui-sans-serif, system-ui, sans-serif; text-decoration: none; } .ds-endpoint:hover { background: var(--bg-hover, #ededed); } .ds-endpoint:focus-visible { outline: 2px solid var(--primary, #b54010); outline-offset: 2px; }"
    },
    {
      "name": "Ghost button",
      "kind": "button",
      "description": "A secondary action with a bordered surface.",
      "html": "<button class=\"ds-ghost\">Copy JSON</button>",
      "css": ".ds-ghost { padding: 5px 10px; border: 1px solid var(--border, #dedede); border-radius: 6px; background: var(--bg-card, #fff); color: var(--text-secondary, #555); font: 500 12px ui-sans-serif, system-ui, sans-serif; } .ds-ghost:hover { background: var(--bg-hover, #ededed); } .ds-ghost:focus-visible { outline: 2px solid var(--primary, #b54010); outline-offset: 2px; }"
    },
    {
      "name": "Workspace navigation",
      "kind": "nav",
      "description": "Switches between request history and endpoint management.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Workspace sections\"><button class=\"ds-nav-active\" aria-pressed=\"true\">Requests</button><button aria-pressed=\"false\">Endpoints</button></nav>",
      "css": ".ds-nav { display: flex; gap: 4px; padding: 4px; background: var(--bg-sidebar, #f7f7f7); } .ds-nav button { border: 0; border-radius: 4px; padding: 8px 10px; color: var(--text-secondary, #555); background: transparent; font: 12px ui-sans-serif, system-ui, sans-serif; } .ds-nav .ds-nav-active { background: var(--bg-selected, #fff3ec); color: var(--primary, #b54010); font-weight: 700; } .ds-nav button:hover { background: var(--bg-hover, #ededed); } .ds-nav button:focus-visible { outline: 2px solid var(--primary, #b54010); outline-offset: 2px; }"
    }
  ],
  "narrative": {
    "northStar": "The Webhook Workbench",
    "overview": "Thoondil uses familiar API client conventions to keep the request stream and inspector easy to navigate. Neutral surfaces, compact controls, and clear dividers put the request data first; the hook identity remains distinct.",
    "keyCharacteristics": [
      "Workspace rail switching between request history and endpoints",
      "Orange action and warm selection on neutral surfaces",
      "Self-hosted Ubuntu documentation headings, system sans-serif interface, and monospace technical values",
      "Flat surfaces and fine dividers"
    ],
    "dos": [
      "Keep method, path, time, body, and response more prominent than decoration.",
      "Pair status color with text, preserve visible focus, and respect reduced-motion preferences.",
      "Use monospace for technical values and sans-serif for prose and labels."
    ],
    "donts": [
      "Do not surround routine ledger content with floating cards."
    ]
  }
}
